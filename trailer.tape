# Renders the README demo: vhs trailer.tape
Output .github/assets/demo.gif

Set FontSize 15
Set Width 1400
Set Height 1120
Set Theme "Catppuccin Mocha"
Set FontFamily "Menlo"
Set TypingSpeed 70ms
Set Padding 24

# log today's entry
Type "feels log"
Enter
Sleep 1s
Type "4"
Enter
Sleep 700ms
Type "4"
Enter
Sleep 900ms
Type "2"
Enter
Sleep 600ms
Type "shipped the dashboard feature today"
Enter
Sleep 2s

# home screen with the streak
Type "clear"
Enter
Type "feels"
Enter
Sleep 3.5s

# recent logs
Type "clear"
Enter
Type "feels logs"
Enter
Sleep 3s

# monthly graph
Type "clear"
Enter
Type "feels graph"
Enter
Sleep 3.5s

# monthly calendar
Type "clear"
Enter
Type "feels calendar"
Enter
Sleep 3.5s
